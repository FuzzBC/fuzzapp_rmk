// WiFiCredentials.h.example
// ============================================================
// Copy this file to "WiFiCredentials.h" in this same folder and fill in
// your real network + OTA credentials. WiFiCredentials.h is gitignored
// (see ../../.gitignore) and must never be committed — this .example file
// is the only version that's tracked in git.
//
// Both Arduino sketches (_FuZzAPP_Diffuser and _FuZzAPP_SmartTV_R4) include
// the real file via a relative path ("../_Shared/WiFiCredentials.h"), so
// there is a single place to edit the WiFi password for both devices.
// See AGENTS.md for the full convention.
#pragma once

#define WIFI_SSID_VALUE      "YourNetworkName"
#define WIFI_PASS_VALUE      "YourNetworkPassword"
#define OTA_PASSWORD_VALUE   "YourOtaPassword"

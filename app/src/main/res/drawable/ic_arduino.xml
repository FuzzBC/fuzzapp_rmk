<?xml version="1.0" encoding="utf-8"?>
<!-- Simple microcontroller board glyph (IC body + legs). White fill so the
     ImageView tint / setColorFilter recolours it for link state. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- chip body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.5,7.5 h9 a1.5,1.5 0 0 1 1.5,1.5 v6 a1.5,1.5 0 0 1 -1.5,1.5 h-9 a1.5,1.5 0 0 1 -1.5,-1.5 v-6 a1.5,1.5 0 0 1 1.5,-1.5 z" />

    <!-- pin-1 notch -->
    <path
        android:fillColor="#20000000"
        android:pathData="M8.5,9 m-0.8,0 a0.8,0.8 0 1,0 1.6,0 a0.8,0.8 0 1,0 -1.6,0" />

    <!-- left legs -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M6,9.5 h-2 M6,12 h-2 M6,14.5 h-2" />

    <!-- right legs -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:pathData="M18,9.5 h2 M18,12 h2 M18,14.5 h2" />
</vector>

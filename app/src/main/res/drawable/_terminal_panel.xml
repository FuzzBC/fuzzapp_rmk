<?xml version="1.0" encoding="utf-8"?>
<!-- Telnet terminal pane: near-black translucent panel + subtle stroke.
     Fixed colours on purpose - terminal theme, not tinted by ThemeManager. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/terminal_panel_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/terminal_panel_stroke" />
    <corners android:radius="10dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Telnet terminal pane: near-black translucent panel + subtle stroke.
     Fixed colours on purpose - terminal theme, not tinted by ThemeManager. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6070B0D" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="10dp" />
</shape>

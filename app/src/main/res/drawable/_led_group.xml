<?xml version="1.0" encoding="utf-8"?>
<!-- Faint rounded surface used behind ColorLayout LED clusters
     (TV screen, BED row, LAMP row) to give the map visual grouping.
     Purely decorative; not touched by ThemeManager - the fill/stroke
     are already low-alpha palette colours (colors.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/led_group_fill" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/led_group_stroke" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug dialog root: panel + header + 2-col grid -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/_stroke_line"
    android:padding="4dp">

    <!-- Header row: traffic-light dots + "DEBUG" label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/_dot_red" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/_dot_yellow" />

        <View
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/_dot_green" />

        <TextView
            android:id="@+id/dbg_header_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="DEBUG"
            android:textColor="@color/text_muted_grey"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 2-column grid of debug items -->
    <GridView
        android:id="@+id/grid_debug_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:numColumns="2"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="4dp"
        android:stretchMode="columnWidth" />

</LinearLayout>

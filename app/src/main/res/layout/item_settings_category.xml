<?xml version="1.0" encoding="utf-8"?>
<!--
  Category SECTION template: icon + title row, teal fade stripe, row container, separator.
  cat_title and cat_icon are set by SettingsManager._buildCategorySections().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="vertical">

    <!-- Header: [icon] TITLE [icon] centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/cat_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:textSize="13sp"
            tools:text="📺" />

        <TextView
            android:id="@+id/cat_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:contextClickable="false"
            android:layerType="software"
            android:letterSpacing="0.28"
            android:linksClickable="false"
            android:longClickable="false"
            android:textAlignment="center"
            android:textColor="@color/skbar_settings_title"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="TextContrastCheck"
            tools:text="TV" />

    </LinearLayout>

    <!-- Teal fade stripe below header -->
    <View
        android:id="@+id/cat_stripe"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/_cat_stripe" />

    <!-- Row container populated by SettingsManager._buildSettingsRows() -->
    <LinearLayout
        android:id="@+id/cat_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Bottom separator between categories -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/cat_bottom_line"
            layout="@layout/_divider_glow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>

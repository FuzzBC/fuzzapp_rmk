<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable "glow divider" - replaces the old flat skbar_line_between bars.
  Soft halo + bright core, both gradient-faded edge to edge and theme-tinted
  at runtime (see SettingsManager._tintGlowDivider()). Caller wraps this
  <include> in a weighted row to control width (e.g. half-width centered).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/glow_halo"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/_divider_glow_halo" />

    <View
        android:id="@+id/glow_core"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/_divider_glow_core" />

</FrameLayout>

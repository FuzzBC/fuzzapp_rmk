<?xml version="1.0" encoding="utf-8"?>
<!-- AppWidgetProviderInfo for FuzzWidgetProvider - compact 4x1 strip.
     updatePeriodMillis is 0 on purpose: the OS floors this at 30 min
     anyway and would fire IN ADDITION to WidgetUpdateWorker's own
     periodic job (started from onEnabled()), doubling network/battery
     cost for no benefit. WorkManager is the single source of scheduled
     refreshes; this just declares the widget's shape/behaviour. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="90dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_fuzz_strip"
    android:previewImage="@mipmap/_fuzz_icon_foreground"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />

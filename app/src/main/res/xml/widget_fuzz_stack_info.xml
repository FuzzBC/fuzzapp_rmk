<?xml version="1.0" encoding="utf-8"?>
<!-- AppWidgetProviderInfo for FuzzWidgetStackProvider - 1x4 stacked
     variant (grew from 1x3 to fit the refresh button + last-refresh
     text). minWidth/minHeight follow the standard cell formula
     (70*cols-30 / 70*rows-30): 1 column ~40dp wide, 4 rows ~250dp tall.
     Same updatePeriodMillis=0 reasoning as widget_fuzz_info.xml - one
     shared WorkManager job (see WidgetScheduling) drives both widgets. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="250dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="150dp"
    android:targetCellWidth="1"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_fuzz_stack"
    android:previewImage="@mipmap/_fuzz_icon_foreground"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />

# =========================
# Local edit-history backup tooling (.cursor/.devin hooks) - logs raw
# prompt text, timestamps, and full before/after file snapshots. Local
# working data, not project source; never commit it.
# =========================
.backup/

# Built application files
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Intellij
*.iml

# Keystore files
*.jks

# =========================
# Operating System Files
# =========================

# OSX
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
# =========================

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

desktop.ini

# =========================
# Claude Code local backups
# =========================

# Pre-edit safety snapshots (see .claude/hooks/backup-before-edit.ps1) -
# local safety net only, not project history.
.claude/.backup/

# =========================
# Local Gradle/JDK cache redirected into project root
# (this project points GRADLE_USER_HOME-style caches here instead of ~/.gradle)
# =========================
/wrapper/
/daemon/
/native/
/jdks/
/android/

# =========================
# IDE / AI-tool-local, not project history
# =========================
.idea/
.codex/
.chatgpt/
.claude/
.cursor/
.devin/
android.lock

# =========================
# Ad-hoc compile/upload debug captures dropped in project root
# =========================
/c[0-9]*.txt
/u[0-9]*.txt
/*_compile*.txt
/*_upload*.txt

# =========================
# Manual backup archives (not project history)
# =========================
*.zip

# =========================
# GitHub release publish token (local secret, never commit)
# =========================
/github_release.properties

# =========================
# WiFi/OTA credentials shared by both Arduino sketches (local secret,
# never commit) - see _ArduinoSide/_Shared/WiFiCredentials.h.example
# =========================
/_ArduinoSide/_Shared/WiFiCredentials.h

# =========================
# FlashConsole device config (COM port, OTA password/host - local to this
# machine, never commit) - see flashconsole_config.json.example
# =========================
/_ArduinoSide/.Compiler/flashconsole_config.json

# FlashConsole single-instance lock file (runtime, not project history)
/_ArduinoSide/.Compiler/.res/.flashconsole.lock

# =========================
# Build-time copy of the root CHANGELOG.md (see copyChangelog in
# app/build.gradle) - root CHANGELOG.md is the source of truth, not this.
# =========================
/app/src/main/assets/CHANGELOG.md

# Python cache
__pycache__/
*.pyc

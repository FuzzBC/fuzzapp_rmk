<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>FuZz TestMode (rmk)</title>
<hta:application
  id="TestModeHTA"
  applicationname="FuZz TestMode (rmk)"
  border="thick"
  caption="yes"
  maximizebutton="yes"
  minimizebutton="yes"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  windowstate="normal"
  scroll="yes"
  scrollflat="yes"
  contextmenu="no"
  selection="yes"
  navigable="no"
/>
<link rel="stylesheet" href=".res/app.css">
</head>
<body onload="window.resizeTo(1180,860); window.moveTo(Math.max(0,(screen.availWidth-1180)/2), Math.max(0,(screen.availHeight-860)/2));">

<div class="topbar">
  <div class="brand">FuZz TestMode (rmk) &middot; v1 binary protocol</div>
  <div class="devswitch">
    <button id="dev-diffuser" class="on">Diffuser</button>
    <button id="dev-smarttv">SmartTV</button>
  </div>
  <div class="topbar-right">
    <span id="conn-ip" class="conn-ip"></span>
    <button id="keepalive-btn" class="pill-btn">Keep-alive: off</button>
  </div>
</div>

<div class="page">
  <div id="hero" class="hero"></div>

  <div class="section-title">Categories</div>
  <div id="tile-grid" class="tile-grid"></div>
</div>

<button id="quicktest-fab" class="fab-left hidden">&#9889;</button>
<button id="activity-fab" class="fab">&#9776;<span id="activity-badge" class="fab-badge hidden">0</span></button>

<div id="quicktest-panel" class="quicktest-panel">
  <div class="sheet-head">
    <div class="sheet-title">Quick commands</div>
    <button id="quicktest-close" class="icon-btn">&#10005;</button>
  </div>
  <div id="quicktest-row" class="quicktest-list"></div>
</div>

<div id="sheet-scrim" class="scrim hidden"></div>
<div id="sheet" class="sheet">
  <div class="sheet-head">
    <div id="sheet-title" class="sheet-title"></div>
    <button id="sheet-close" class="icon-btn">&#10005;</button>
  </div>
  <div id="sheet-body" class="sheet-body"></div>
</div>

<div id="activity-panel" class="activity-panel">
  <div class="sheet-head">
    <div class="sheet-title">Activity</div>
    <div class="sheet-head-actions">
      <button id="activity-savelog" class="pill-btn small">SaveLog</button>
      <button id="activity-close" class="icon-btn">&#10005;</button>
    </div>
  </div>
  <div id="activity-log" class="activity-log"></div>
  <div class="raw-row">
    <label>Raw</label>
    <select id="raw-transport"></select>
    <select id="raw-opcode" title="Opcode (UDP only - ignored for Telnet)"></select>
    <input id="raw-payload" type="text" placeholder="UDP: hex payload bytes, e.g. 01 for HELLO proto_version=1 / Telnet: plain text">
    <label><input id="raw-envelope" type="checkbox" checked> framed</label>
    <button id="raw-send-btn" class="pill-btn small">Send</button>
  </div>
</div>

<!-- protocol_opcodes.js (GENERATED - see gen_protocol.py) must load before
     data.js, which calls Proto.packSetAmbientMode()/packSetTelnetEnable()
     while building the direct_buttons byte payloads at parse time. -->
<script src=".res/protocol_opcodes.js"></script>
<script src=".res/data.js"></script>
<script src=".res/protocol.js"></script>
<script src=".res/net.js"></script>
<script src=".res/controls.js"></script>
<script src=".res/result-view.js"></script>
<script src=".res/ui.js"></script>
</body>
</html>

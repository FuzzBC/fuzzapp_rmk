// WiFiCredentials.h.example
// ============================================================
// Copy this file to "WiFiCredentials.h" in this same folder and fill in
// your real network + OTA credentials. WiFiCredentials.h must never be
// committed — this .example file is meant to be the tracked version.
//
// Both _rmk_ Arduino sketches (_rmk_Diffuser and _rmk_SmartTV_R4) include
// the real file via an ad-hoc --library search path pointing at this same
// _rmk_Shared folder (angle-bracket #include <WiFiCredentials.h> - a
// quoted relative include doesn't reliably resolve under arduino-cli), so
// there is a single place to edit the WiFi password for both devices.
#pragma once

#define WIFI_SSID_VALUE      "YourNetworkName"
#define WIFI_PASS_VALUE      "YourNetworkPassword"
#define OTA_PASSWORD_VALUE   "YourOtaPassword"
// Fixed MQTT topic id for the SmartTV (fuzz/<this>/...) - any short
// alnum string, up to 16 chars (see Globals.h MQTT_DEVICE_ID_MAX). Must
// match MqttTransport.DEFAULT_DEVICE_ID on the app side exactly.
#define MQTT_DEVICE_ID_VALUE "YourDeviceId"
